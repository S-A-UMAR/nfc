# STRIDE Platform — Environment Variables Template
# Copy this file to .env for local development
# NEVER commit .env — it is in .gitignore

# ── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-strong-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Site URL (used in email links, NFC redirects, vCard, etc.) ───────────────
# Local:        http://127.0.0.1:8000
# On Railway:   https://your-app.up.railway.app
# Production:   https://strideid.com (once domain is purchased & connected)
SITE_URL=http://127.0.0.1:8000

# ── Cookie / HTTPS (set True only in production with HTTPS) ─────────────────
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# ── Brevo Transactional Email ────────────────────────────────────────────────
# Completely new account credentials. Never reuse old UZYRA keys or identities.
# In development (DEBUG=True) and test runs, live emails are completely simulated.
# In production, set to your new verified Brevo API key and verified sender address.
BREVO_API_KEY=your-new-brevo-api-key-here
BREVO_SENDER_EMAIL=notifications@strideid.com
BREVO_SENDER_NAME=STRIDE

# ── Paystack Payments ────────────────────────────────────────────────────────
# Use TEST keys for staging (pk_test_... / sk_test_...)
# NEVER use live keys on a staging/development environment
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
PAYSTACK_TEST_MODE=True

# ── PostgreSQL Database (Neon Serverless PostgreSQL / Railway PostgreSQL) ───
# In production (DEBUG=False), DATABASE_URL is strictly required.
# In local development, leave unset to use local SQLite3, or set to a PostgreSQL URL.
# For Neon Connection Pooling (recommended for web workers):
# Example: postgresql://user:password@ep-cool-123-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# For Neon Direct Connection (or Railway internal):
# Example: postgresql://user:password@ep-cool-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-your-host.neon.tech/neondb?sslmode=require

# ── Redis (Shared Cache & Rate Limiting) ────────────────────────────────────
# In production (DEBUG=False), REDIS_URL is strictly required.
# In local development, leave unset to safely fall back to LocMemCache.
# Example: redis://default:password@viaduct.proxy.rlwy.net:6379
REDIS_URL=redis://default:password@viaduct.proxy.rlwy.net:6379

# ── Cloudinary Persistent Media Storage ──────────────────────────────────────
# When set, user uploads & avatars are stored on Cloudinary CDN instead of local disk
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Brand & Support ──────────────────────────────────────────────────────────
BRAND_NAME=STRIDE
BRAND_TAGLINE=Modern Identity. Seamless Connection.
BRAND_DOMAIN=strideid.com
BRAND_SUPPORT_EMAIL=support@strideid.com
BRAND_SUPPORT_PHONE=07045003128
BRAND_SUPPORT_PHONE_INTL=+2347045003128
BRAND_SUPPORT_PHONE_WA=2347045003128
