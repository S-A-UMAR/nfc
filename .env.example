# UZYRA Platform — Environment Variables Template
# Copy this file to .env for local development
# NEVER commit .env — it is in .gitignore

# ── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-strong-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Site URL (used in email links, NFC redirects, vCard, etc.) ───────────────
# Local:      http://127.0.0.1:8000
# On Render:  https://your-app-name.onrender.com
SITE_URL=http://127.0.0.1:8000

# ── Cookie / HTTPS (set True only in production with HTTPS) ─────────────────
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# ── Brevo Transactional Email ────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=contact@yourdomain.com
BREVO_SENDER_NAME=STRIDE

# ── Paystack Payments ────────────────────────────────────────────────────────
# Use TEST keys for staging (pk_test_... / sk_test_...)
# NEVER use live keys on a staging/development environment
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
PAYSTACK_TEST_MODE=True

# ── PostgreSQL Database (Neon / Cloud PostgreSQL) ───────────────────────────
# In production (DEBUG=False), DATABASE_URL is strictly required.
# In local development, leave unset to use local SQLite3, or set to a PostgreSQL URL.
# Example (Neon): postgresql://user:password@ep-cool-lake.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-your-host.neon.tech/neondb?sslmode=require

# ── Cloudinary Persistent Media Storage ──────────────────────────────────────
# When set, user uploads & avatars are stored on Cloudinary CDN instead of local disk
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Brand ────────────────────────────────────────────────────────────────────
BRAND_NAME=STRIDE
